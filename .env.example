# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Database ---
# Use Neon's POOLED connection string here (the one with "-pooler" in the
# hostname) — this is what makes the app fast and stable under real
# traffic, since serverless functions open many short-lived connections
# and Postgres itself has a low hard limit on direct connections.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.neon.tech/sutragenz?sslmode=require

# Use Neon's DIRECT (non-pooled) connection string here — Prisma needs
# this specifically for running migrations, which pooled connections
# don't support well.
DIRECT_URL=postgresql://user:password@ep-xxxx.neon.tech/sutragenz?sslmode=require

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Providers (multi-model routing) ---
# You only need ONE of these. GOOGLE_GEMINI_API_KEY is the free option —
# no credit card, Gemini 2.5 Flash, no expiration (as of 2026). See README
# for the fully-free deployment path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Video generation ---
RUNWAY_API_KEY=

# --- Real deployment from AI Project Builder (optional) ---
# Get this from vercel.com/account/tokens. Without it, the "Deploy to
# Vercel" button shows a clear "not configured" message instead of failing.
VERCEL_API_TOKEN=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
